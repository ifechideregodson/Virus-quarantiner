# Copy these into your environment (or your host's settings page).
# Local development:
DJANGO_DEBUG=1

# Production (DJANGO_DEBUG unset or 0). The secret key is required.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Set to 1 when the site is served over HTTPS (secure cookies, HSTS, redirect).
DJANGO_HTTPS=1

# Optional: where the SQLite database and uploaded release packages live.
# DJANGO_DB_PATH=/var/lib/shieldscan/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/lib/shieldscan/media
